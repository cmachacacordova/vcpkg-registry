diff --git a/list.h b/list.h
index 3c8d234..3ff4c47 100644
--- a/list.h
+++ b/list.h
@@ -3,6 +3,19 @@
 
 #include <stddef.h>
 
+/* C++ consumers may pull in this header directly. The `restrict` keyword is
+ * not valid in standard C++, and MSVC does not accept it as a qualifier.
+ * Normalize it to the compiler-specific extension before any declarations. */
+#ifdef __cplusplus
+#ifndef restrict
+#ifdef _MSC_VER
+#define restrict __restrict
+#else
+#define restrict __restrict__
+#endif
+#endif
+#endif
+
